#!/usr/bin/env bash
set -Eeuo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
dry_run=false
packages=true
local_packages=true
swayfx=true
firefox=true
session=true
firefox_args=()
usage() {
  printf '%s\n' \
    "Usage: $0 [options]" \
    '  --dry-run                 Print the plan without running commands or sudo' \
    '  --skip-packages           Do not upgrade/install packages from pacman.txt' \
    '  --skip-local-packages     Skip the vendored Clipse and 1Password CLI builds' \
    '  --skip-swayfx             Skip the SwayFX build and Ly session registration' \
    '  --skip-firefox            Leave Firefox untouched' \
    '  --skip-session            Build SwayFX without registering it with Ly' \
    '  --firefox-profile PATH    Use an existing Firefox profile explicitly' \
    '  -h, --help                Show this help' \
    '' \
    'Run as your regular user, from stock Sway or a text TTY, with Firefox closed.' \
    'Firefox must have been started once to create a profile, or use --skip-firefox.' \
    'Packages use a full Arch upgrade; sudo/pacman retain their normal prompts.' \
    'No AUR helper/live recipe downloads, automatic reboot, or service restart.'
}
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --skip-packages) packages=false ;;
    --skip-local-packages) local_packages=false ;;
    --skip-swayfx) swayfx=false ;;
    --skip-firefox) firefox=false ;;
    --skip-session) session=false ;;
    --firefox-profile)
      [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || die '--firefox-profile requires a directory'
      firefox_args=(--profile "$2")
      shift ;;
    --help|-h) usage; exit 0 ;;
    *) die "Unknown option: $1 (use --help)" ;;
  esac
  shift
done
if ! "$swayfx"; then session=false; fi
if ! "$firefox" && [[ ${#firefox_args[@]} -gt 0 ]]; then
  die '--firefox-profile cannot be combined with --skip-firefox'
fi
trap 'status=$?; printf "Setup stopped (exit %s). Earlier steps may have completed; check the output and backups before rerunning.\n" "$status" >&2; exit "$status"' ERR
export PATH="$HOME/.local/bin:$PATH"

if ! "$dry_run"; then
  [[ $EUID -ne 0 ]] || die 'Do not run setup with sudo; it would install user files into root HOME.'
  for script in apply-desktop install-yt-x install-kitten install-mandible; do
    [[ -x "$repo/scripts/$script" ]] || die "Missing executable: scripts/$script"
  done
  if "$local_packages"; then
    [[ -x "$repo/scripts/install-local-packages" ]] || die 'Missing scripts/install-local-packages'
  fi
  if "$packages" || "$session" || "$local_packages"; then
    command -v sudo >/dev/null || die 'sudo is required for packages/session registration'
  fi
  if "$packages"; then
    command -v pacman >/dev/null || die 'This package list requires Arch Linux/pacman'
    [[ -s "$repo/pacman.txt" ]] || die 'pacman.txt is missing or empty'
  fi
  if "$swayfx" || "$firefox"; then
    for cmd in pgrep readlink id; do
      command -v "$cmd" >/dev/null || die "Missing preflight tool: $cmd"
    done
  fi
  if "$swayfx"; then
    [[ -x "$repo/scripts/install-swayfx" ]] || die 'Missing scripts/install-swayfx'
    pids=$(pgrep -u "$(id -u)" -x sway) || {
      status=$?; [[ $status -eq 1 ]] || die 'Could not check running compositor processes'
    }
    for pid in $pids; do
      exe=$(readlink "/proc/$pid/exe") || die "Could not identify running compositor $pid"
      [[ "$exe" != "$HOME/.local/opt/swayfx/bin/sway"* ]] || \
        die 'SwayFX is running. Log into stock Sway/a text TTY, or use --skip-swayfx.'
    done
  fi
  if "$firefox"; then
    [[ -x "$repo/scripts/install-firefox-theme" ]] || die 'Missing scripts/install-firefox-theme'
    if pgrep -u "$(id -u)" -x firefox >/dev/null; then
      die 'Fully quit Firefox first, or use --skip-firefox.'
    else
      status=$?; [[ $status -eq 1 ]] || die 'Could not check Firefox processes'
    fi
    command -v python3 >/dev/null || die 'Python 3 is needed to check Firefox; install it or use --skip-firefox.'
    if ! "$repo/scripts/install-firefox-theme" "${firefox_args[@]}" --dry-run; then
      die 'Create/select a Firefox profile first, or use --skip-firefox and apply its theme later.'
    fi
  fi
fi

step=0
run() {
  step=$((step + 1))
  printf '\n[%s] ' "$step"
  printf '%q ' "$@"
  printf '\n'
  if ! "$dry_run"; then "$@"; fi
}
if "$dry_run"; then printf 'DRY RUN: no commands, downloads, sudo, or files will be changed.\n'; fi
if "$packages"; then
  step=$((step + 1))
  printf '\n[%s] sudo pacman -Syu --needed - < %q\n' "$step" "$repo/pacman.txt"
  if ! "$dry_run"; then sudo pacman -Syu --needed - < "$repo/pacman.txt"; fi
fi
if "$local_packages"; then run "$repo/scripts/install-local-packages"; fi
run "$repo/scripts/apply-desktop"
if "$swayfx"; then run "$repo/scripts/install-swayfx"; fi
run "$repo/scripts/install-yt-x"
run "$repo/scripts/install-kitten"
run "$repo/scripts/install-mandible"
if "$firefox"; then run "$repo/scripts/install-firefox-theme" "${firefox_args[@]}"; fi
if "$session"; then
  run sudo install -D -m 644 "$HOME/.local/share/wayland-sessions/swayfx.desktop" \
    /usr/share/wayland-sessions/swayfx.desktop
fi
if "$dry_run"; then
  printf '\nPreview complete. Rerun without --dry-run to apply the selected steps.\n'
else
  printf '\nSetup complete. Backups: ~/.local/state/dotfiles/backups/\n'
  printf 'Check your monitor settings and install GeistMono Nerd Font if missing.\n'
  if "$session"; then
    printf 'Save your work and reboot when ready; select SwayFX (Bauhaus) in Ly.\n'
  fi
  printf 'No applications were restarted, services enabled, or reboot performed.\n'
fi
