#!/usr/bin/env fish

# Bindings and completion state live only in this launcher's Fish process.
function __add_task_complete
    set -l token (commandline --current-token | string unescape)
    set -l attribute
    set -l choices
    set -l prompt

    if string match --quiet 'project:*' -- "$token"
        set attribute 'project:'
        set prompt 'Project > '
        set choices (command task rc.list.all.projects=0 _projects 2>/dev/null)
    else if string match --quiet '+*' -- "$token"
        set attribute '+'
        set prompt 'Tag > '
        # _tags includes virtual tags; _unique returns only tags actually used.
        set choices (command task _unique tags 2>/dev/null | string split ',' | string match --regex '.+' | sort -u)
    else
        return
    end

    test (count $choices) -gt 0; or return
    set -l prefix (string sub --start (math (string length -- "$attribute") + 1) -- "$token")
    # Ignore global fzf options so personal preview commands/layouts don't leak in.
    set -l choice (printf '%s\n' $choices | command env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE fzf \
        --height=~10 --layout=reverse --border --no-multi \
        --prompt="$prompt" --query="$prefix" --bind='tab:down,shift-tab:up')
    if test $status -eq 0; and string length --quiet -- $choice
        commandline --current-token --replace -- (string escape -- "$attribute$choice")
    end
    commandline --function repaint
end

bind tab __add_task_complete
bind -M insert tab __add_task_complete

# Keep redirected output plain and respect terminals with colors disabled.
set -l project_color ''
set -l tag_color ''
set -l date_color ''
set -l priority_color ''
set -l reset ''
if isatty stdout; and test "$TERM" != dumb; and not set -q NO_COLOR
    set project_color (set_color cyan)
    set tag_color (set_color magenta)
    set date_color (set_color green)
    set priority_color (set_color yellow)
    set reset (set_color normal)
end

printf '  Project     %sproject:work%s        Tab opens project menu\n' "$project_color" "$reset"
printf '  Subproject  %sproject:work.website%s\n' "$project_color" "$reset"
printf '  Tags        %s+email +errands%s     Tab after + opens tag menu\n' "$tag_color" "$reset"
printf '  Due date    %sdue:tomorrow%s        due:2026-12-31 or due:friday\n' "$date_color" "$reset"
printf '  Due time    %sdue:tomorrowT09:00%s\n' "$date_color" "$reset"
printf '  Schedule    %sscheduled:monday%s    Planned start date\n' "$date_color" "$reset"
printf '  Hide until  %swait:friday%s         Hide from pending until Friday\n' "$date_color" "$reset"
printf '  Priority    %spriority:H%s          H (high), M (medium), L (low)\n' "$priority_color" "$reset"
printf '  Repeat      %srecur:weekly%s        Also needs a due: date\n\n' "$date_color" "$reset"

set -l draft ''
while true
    read --local --command "$draft" -P 'Task: ' draft; or exit 0
    string match --quiet --regex '\S' -- "$draft"; or exit 0
    # Tokenize without eval: quotes work, but shell code is never executed.
    printf '%s\n' "$draft" | read --tokenize --array --local task_args
    string length --quiet -- $task_args; or exit 0

    if command task add $task_args
        printf '\nAdded: %s\n' "$draft"
        sleep 2
        exit 0
    end

    printf '\nCould not add task. Edit the entry and retry, or Ctrl+C to cancel.\n\n' >&2
end
