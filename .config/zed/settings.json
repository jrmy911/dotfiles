{
    "ui_font_weight": 500.0,
    "tasks": {
        "enabled": true
    },
    "lsp_document_colors": "inlay",
    "buffer_line_height": "comfortable",
    "buffer_font_weight": 400.0,
    "show_edit_predictions": false,
    "notification_panel": {
        "button": false
    },
    "collaboration_panel": {
        "button": false,
        "dock": "right"
    },
    "document_symbols": "off",
    "outline_panel": {
        "dock": "left",
        "git_status": true,
        "button": false
    },
    "active_pane_modifiers": {
        "border_size": 2.0,
        "inactive_opacity": 0.7
    },
    "preview_tabs": {
        "enable_preview_from_project_panel": false
    },
    "autosave": "off",
    "ui_font_family": "Geist Mono",
    "use_system_window_tabs": false,
    "window_decorations": "client",
    "bottom_dock_layout": "contained",
    "tab_bar": {
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false,
        "show": false
    },
    "tabs": {
        "close_position": "right",
        "show_close_button": "hidden",
        "git_status": false
    },
    "debugger": {
        "button": false
    },
    "search": {
        "button": false
    },
    "diagnostics": {
        "button": false
    },
    "status_bar": {
        "cursor_position_button": false,
        "active_language_button": true
    },
    "project_panel": {
        "dock": "left",
        "auto_open": {
            "on_create": true
        },
        "button": false
    },
    "tab_size": 4,
    "toolbar": {
        "selections_menu": true,
        "quick_actions": false,
        "breadcrumbs": true,
        "agent_review": false
    },
    "scrollbar": {
        "axes": {
            "vertical": false,
            "horizontal": false
        },
        "diagnostics": "warning",
        "show": "never"
    },
    "buffer_font_family": "Geist Mono",
    "ssh_connections": [],
    "git_panel": {
        "button": false,
        "tree_view": true,
        "status_style": "icon",
        "dock": "right"
    },
    "calls": {
        "mute_on_join": true
    },
    "title_bar": {
        "show_menus": false,
        "show_user_picture": false,
        "show_user_menu": false,
        "show_sign_in": false,
        "show_onboarding_banner": false,
        "show_project_items": true,
        "show_branch_name": true
    },
    "auto_update": true,
    "terminal": {
        "font_family": "Geist Mono",
        "font_size": 16.0,
        "shell": "system",
        "button": false,
        "dock": "bottom"
    },
    "vim": {
        "cursor_shape": {
            "insert": "bar",
            "replace": "bar"
        },
        "gdefault": true,
        "toggle_relative_line_numbers": true
    },
    "languages": {
        "Terraform": {
            "show_edit_predictions": true
        },
        "Ansible": {
            "tab_size": 2
        },
        "Bicep": {
            "tab_size": 2
        }
    },
    "restore_on_startup": "none",
    "agent": {
        "dock": "right",
        "button": false,
        "default_profile": "ask",
        "default_model": {
            "enable_thinking": true,
            "provider": "openrouter",
            "model": "z-ai/glm-5.1"
        },
        "model_parameters": []
    },
    "icon_theme": "Material Icon Theme",
    "vim_mode": true,
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "ui_font_size": 17.0,
    "buffer_font_size": 17.0,
    "theme": {
        "mode": "system",
        "light": "Rosé Pine Dawn",
        "dark": "Bauhaus Dark"
    },
    "file_types": {
        "Ansible": [
            "**.ansible.yml",
            "**.ansible.yaml",
            "**/defaults/*.yml",
            "**/defaults/*.yaml",
            "**/meta/*.yml",
            "**/meta/*.yaml",
            "**/tasks/*.yml",
            "**/tasks/*.yaml",
            "**/handlers/*.yml",
            "**/handlers/*.yaml",
            "**/group_vars/*.yml",
            "**/group_vars/*.yaml",
            "**/host_vars/*.yml",
            "**/host_vars/*.yaml",
            "**/playbooks/*.yml",
            "**/playbooks/*.yaml",
            "**playbook*.yml",
            "**playbook*.yaml"
        ]
    }
}
