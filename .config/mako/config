# --- Bauhaus (shared with Ghostty and Sway) ---
font=GeistMono Nerd Font 10
text-color=#C6CED8
border-color=#222733
background-color=#101318
# Bauhaus coral, matching Waybar's focused workspace number.
progress-color=over #E37B66
width=420
height=110
padding=14
margin=10
border-size=1
border-radius=14
icons=1
icon-border-radius=8
max-icon-size=48
default-timeout=5000

# --- Center the OSD for Volume/Brightness ---
[category=volume]
anchor=top-center
default-timeout=2000

[category=brightness]
anchor=top-center
default-timeout=2000

[urgency=high]
border-color=#E37B66
